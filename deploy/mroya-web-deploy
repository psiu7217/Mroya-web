#!/usr/bin/env bash
# Root: Docker/runtime files. psiu: dedicated HTTPS Git checkout.
set -Eeuo pipefail
umask 077
[[ $EUID == 0 && $# == 0 ]] || { echo 'Usage: sudo /usr/local/sbin/mroya-web-deploy'; exit 1; }
checkout=/home/psiu/mroya-web-deployment
config=/etc/mroya-web-deploy
state=/var/lib/mroya-web-deploy
remote=https://github.com/psiu7217/Mroya-web.git
stage=preflight
context=
trap 'echo "ERROR: $stage (exit $?). No automatic rollback." >&2' ERR
trap '[[ -z "$context" ]] || rm -rf -- "$context"' EXIT
# Same lock as the existing installer/helper; old state is not read or removed.
exec 9>"$state/deployment.lock"
flock -n 9 || { echo 'ERROR: another Web operation is running'; exit 1; }
export DOCKER_HOST=unix:///var/run/docker.sock DOCKER_CONFIG="$config/docker-cli"
as_psiu() { sudo -u psiu -H env GIT_TERMINAL_PROMPT=0 "$@"; }
git_as_psiu() {
    local result=0
    as_psiu git -c credential.helper= -c "credential.helper=store --file=/home/psiu/.config/mroya/git-credentials" "$@" 2>/dev/null || result=$?
    return "$result"
}
for file in compose.yaml empty.env Dockerfile nginx.conf; do [[ -f "$config/$file" ]]; done
stage='HTTPS main checkout (expected psiu owner, clean main and official origin)'
if [[ ! -e "$checkout" ]]; then
    git_as_psiu clone --branch main "$remote" "$checkout" >/dev/null
fi
[[ ! -L "$checkout" && "$(stat -c %U "$checkout")" == psiu && "$(stat -c %U "$checkout/.git")" == psiu ]]
origin=$(git_as_psiu -C "$checkout" remote get-url origin )
[[ "$origin" == "$remote" ]]
branch=$(git_as_psiu -C "$checkout" branch --show-current )
[[ "$branch" == main ]]
dirty=$(git_as_psiu -C "$checkout" status --porcelain )
[[ -z "$dirty" ]]
git_as_psiu -C "$checkout" pull --ff-only origin main >/dev/null
sha=$(git_as_psiu -C "$checkout" rev-parse HEAD)
[[ "$sha" == "$(git_as_psiu -C "$checkout" rev-parse FETCH_HEAD)" ]]
dirty=$(git_as_psiu -C "$checkout" status --porcelain )
[[ -z "$dirty" ]]
echo "Building approved main $sha"
stage='tracked npm lockfile (primary or fallback) required'
lock_source=package-lock.json
if git_as_psiu -C "$checkout" cat-file -e "$sha:package-lock.json"; then
    :
elif git_as_psiu -C "$checkout" cat-file -e "$sha:deploy/npm-lock.fallback.json"; then
    lock_source=deploy/npm-lock.fallback.json
    echo 'INFO: canonical package-lock.json absent; using reviewed deploy/npm-lock.fallback.json' >&2
else
    echo 'ERROR: both package-lock.json and deploy/npm-lock.fallback.json are absent from main' >&2
    false
fi
stage='temporary production build context'
context=$(mktemp -d /tmp/mroya-web-build.XXXXXX)
files=(package.json index.html tsconfig.json vite.config.ts src scripts/check-production.mjs)
files+=("$lock_source")
if git_as_psiu -C "$checkout" cat-file -e "$sha:public"; then files+=(public); fi
git_as_psiu -C "$checkout" archive "$sha" -- "${files[@]}" | tar -xf - -C "$context"
# Restore only inside the temporary build context, without modifying the Git checkout.
if [[ "$lock_source" != package-lock.json ]]; then
    cp "$context/$lock_source" "$context/package-lock.json"
fi
mkdir -p "$context/public"
cp "$config/Dockerfile" "$context/Dockerfile"
cp "$config/nginx.conf" "$context/nginx.conf"
stage='production build: npm ci (lock must match), TypeScript, Vite and bundle check'
/usr/bin/docker build --pull=false -t "mroya-web:$sha" "$context"
# Stable runtime tag: base Compose and ordinary restarts select this same image.
stage='publish Web image'
/usr/bin/docker image tag "mroya-web:$sha" mroya-web:production
compose=(/usr/libexec/docker/cli-plugins/docker-compose --project-directory "$config" --env-file "$config/empty.env" -p mroya-web -f "$config/compose.yaml")
stage='Web-only Compose startup'
"${compose[@]}" up -d --no-deps --no-build --pull never web
stage='local Nginx HTTP smoke'
available=false
for ((attempt=0; attempt<30; attempt++)); do
    if "${compose[@]}" exec -T web wget -q -T 3 -O /dev/null http://127.0.0.1:8080/; then available=true; break; fi
    sleep 2
done
[[ "$available" == true ]]
echo "SUCCESS: mroya-web $sha"
