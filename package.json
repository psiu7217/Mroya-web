{
  "name": "mroya-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode design --port=3000 --host=0.0.0.0",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:design": "vite build --mode design --outDir dist-design",
    "build:production": "vite build --mode production",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "motion": "^12.23.24",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-breaks": "^4.0.0",
    "pixi.js": "8.22.0",
    "d3-force": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "3.0.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
